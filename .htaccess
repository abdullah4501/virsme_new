<IfModule mod_rewrite.c>
    RewriteEngine On

    # Leave real files and directories alone
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through React
    RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes